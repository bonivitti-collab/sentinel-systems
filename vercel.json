{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.sentinelsystems.com.br"
        }
      ],
      "destination": "https://sentinelsystems.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sentinelsystems.com.br"
        }
      ],
      "destination": "https://sentinelsystems.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "valorhora.sentinelsystems.com.br"
        }
      ],
      "destination": "/valorhora",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "cotacasa.sentinelsystems.com.br"
        }
      ],
      "destination": "/cotacasa",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/quem-somos",
      "destination": "/#sobre",
      "permanent": true
    },
    {
      "source": "/sobre",
      "destination": "/#sobre",
      "permanent": true
    },
    {
      "source": "/automacao",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/automacao/:slug",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/solucoes/:slug",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/cidades/:slug",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/servicos",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/sites",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/videos",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/contato",
      "destination": "/#contato",
      "permanent": true
    },
    {
      "source": "/demos/brasa-folha",
      "destination": "/demos/brasa-folha/index.html",
      "permanent": true
    },
    {
      "source": "/demos/casa-linho",
      "destination": "/demos/casa-linho/index.html",
      "permanent": true
    },
    {
      "source": "/demos/salao-aurora",
      "destination": "/demos/salao-aurora/index.html",
      "permanent": true
    },
    {
      "source": "/ferramentas",
      "destination": "/#produtos",
      "permanent": true
    },
    {
      "source": "/guias",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guias/:slug",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/valorhora",
      "destination": "/valorhora/index.html"
    },
    {
      "source": "/cotacasa",
      "destination": "/cotacasa/index.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade/index.html"
    },
    {
      "source": "/termos",
      "destination": "/termos/index.html"
    },
    {
      "source": "/d/:slug",
      "destination": "/d/:slug/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/demos/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/d/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/videos/(.*\\.mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "video/mp4"
        }
      ]
    },
    {
      "source": "/videos/(.*\\.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
