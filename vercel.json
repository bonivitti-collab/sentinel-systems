{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.sentinelsystems.com.br" }],
      "destination": "https://sentinelsystems.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sentinelsystems.com.br" }],
      "destination": "https://sentinelsystems.com.br/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/quem-somos", "destination": "/sobre", "permanent": true },
    { "source": "/sites", "destination": "/servicos", "permanent": true },
    { "source": "/automacao", "destination": "/servicos", "permanent": true },
    { "source": "/automacao/:slug", "destination": "/servicos", "permanent": true },
    { "source": "/blog", "destination": "/faq", "permanent": true },
    { "source": "/solucoes/:slug", "destination": "/servicos", "permanent": true },
    { "source": "/cidades/:slug", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sobre", "destination": "/sobre/index.html" },
    { "source": "/servicos", "destination": "/servicos/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/contato", "destination": "/contato/index.html" },
    { "source": "/guias", "destination": "/guias/index.html" },
    { "source": "/guias/como-colocar-meu-negocio-no-google", "destination": "/guias/como-colocar-meu-negocio-no-google/index.html" },
    { "source": "/guias/vale-a-pena-ter-site-pequeno-negocio", "destination": "/guias/vale-a-pena-ter-site-pequeno-negocio/index.html" },
    { "source": "/guias/como-vender-mais-pelo-whatsapp", "destination": "/guias/como-vender-mais-pelo-whatsapp/index.html" },
    { "source": "/guias/quanto-custa-fazer-um-site", "destination": "/guias/quanto-custa-fazer-um-site/index.html" },
    { "source": "/guias/instagram-nao-traz-cliente", "destination": "/guias/instagram-nao-traz-cliente/index.html" },
    { "source": "/d/:slug", "destination": "/d/:slug/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/demos/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/d/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
